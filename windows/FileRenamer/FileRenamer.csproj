<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 产品版本号：SDK 据此生成程序集/文件/信息版本
         （微软文档 https://learn.microsoft.com/dotnet/core/project-sdk/msbuild-props） -->
    <Version>0.1.3</Version>
    <!-- 不把 git 提交哈希追加到 InformationalVersion，保持版本号显示干净 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 单文件自包含发布：依据微软官方文档 https://learn.microsoft.com/dotnet/core/deploying/single-file/overview -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 压缩内嵌程序集：127MB → 55MB，代价是启动时在内存中解压（微软官方文档 EnableCompressionInSingleFile） -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

</Project>